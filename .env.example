# MARSHAL ERP - ENVIRONMENT VARIABLES CONFIGURATION
PORT=5000
NODE_ENV=development

# Security JWT Secret Key
JWT_SECRET=marshal_erp_jwt_secret_key_2026_super_secure

# Database Configuration (SQLite local path / Cloudflare D1 connection)
DB_PATH=./db/marshal_erp.db

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_uuid

# Live Sync Port
WS_PORT=5000
